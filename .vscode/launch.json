{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension on fixtures",
      "type": "extensionHost",
      "request": "launch",
      // golang.go (gopls semantic tokens), the colour theme and remote-wsl must stay enabled: the
      // point is to see these decorations as a user would. --disable-extensions would drop them
      // too, so everything else installed on the owner's machine is switched off by name; an id
      // that is not installed is ignored. Refresh the list with:
      //   ls ~/.vscode-server/extensions   (WSL side) and %USERPROFILE%\.vscode\extensions
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=amazonwebservices.aws-toolkit-vscode",
        "--disable-extension=andrewbutson.vscode-openapi-viewer",
        "--disable-extension=anthropic.claude-code",
        "--disable-extension=charliermarsh.ruff",
        "--disable-extension=chihayaanon.mcp-config-manager-extension",
        "--disable-extension=christian-kohler.path-intellisense",
        "--disable-extension=codezombiech.gitignore",
        "--disable-extension=davidanson.vscode-markdownlint",
        "--disable-extension=esbenp.prettier-vscode",
        "--disable-extension=github.vscode-github-actions",
        "--disable-extension=gitlab.gitlab-workflow",
        "--disable-extension=hashicorp.hcl",
        "--disable-extension=hashicorp.terraform",
        "--disable-extension=inferrinizzard.prettier-sql-vscode",
        "--disable-extension=mechatroner.rainbow-csv",
        "--disable-extension=mermaidchart.vscode-mermaid-chart",
        "--disable-extension=mkhl.shfmt",
        "--disable-extension=ms-azuretools.vscode-containers",
        "--disable-extension=ms-python.black-formatter",
        "--disable-extension=ms-python.debugpy",
        "--disable-extension=ms-python.python",
        "--disable-extension=ms-python.vscode-pylance",
        "--disable-extension=ms-python.vscode-python-envs",
        "--disable-extension=ms-toolsai.jupyter",
        "--disable-extension=ms-toolsai.jupyter-keymap",
        "--disable-extension=ms-toolsai.jupyter-renderers",
        "--disable-extension=ms-toolsai.vscode-jupyter-cell-tags",
        "--disable-extension=ms-toolsai.vscode-jupyter-slideshow",
        "--disable-extension=ms-vscode-remote.remote-containers",
        "--disable-extension=ms-vscode.makefile-tools",
        "--disable-extension=ms-vscode.powershell",
        "--disable-extension=ms-vscode.vscode-chat-customizations-evaluations",
        "--disable-extension=myriad-dreamin.tinymist",
        "--disable-extension=piotrpalarz.vscode-gitignore-generator",
        "--disable-extension=quarto.quarto",
        "--disable-extension=redhat.java",
        "--disable-extension=redhat.vscode-yaml",
        "--disable-extension=roonie007.hide-files",
        "--disable-extension=shd101wyy.markdown-preview-enhanced",
        "--disable-extension=tamasfe.even-better-toml",
        "--disable-extension=timonwong.shellcheck",
        "--disable-extension=tomoki1207.pdf",
        "--disable-extension=vscjava.vscode-gradle",
        "--disable-extension=vscjava.vscode-java-debug",
        "--disable-extension=vscjava.vscode-java-dependency",
        "--disable-extension=vscjava.vscode-java-pack",
        "--disable-extension=vscjava.vscode-java-test",
        "--disable-extension=vscjava.vscode-maven",
        "--disable-extension=wiidede.liquid-ray",
        "--disable-extension=yzane.markdown-pdf",
        "--disable-extension=yzhang.markdown-all-in-one",
        "${workspaceFolder}/test/fixtures"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: build"
    }
  ]
}
